APP_NAME="VitaNatural E2E"
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8011
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

# Dejar vacio. e2e:reset rechaza cualquier DB_URL no vacio.
DB_URL=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tienda_virtual_natural_e2e
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=vitanatural_e2e_session
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=array
ORDER_EMAIL_IMAGE_REMOTE_HOSTS=
LOG_CHANNEL=stderr

# Valores locales obligatorios al copiar este archivo como .env.e2e.
E2E_CUSTOMER_EMAIL="e2e.customer@vitanatural.test"
E2E_ADMIN_EMAIL="e2e.admin@vitanatural.test"
E2E_CUSTOMER_PASSWORD="ClienteE2E_2026!"
E2E_ADMIN_PASSWORD="AdminE2E_2026!"
